    count = num // 50000
    num %= 50000
    print("50000원 지폐: {}장".format(count))
    count = num // 10000
    num %= 10000
    print("10000원 지폐: {}장".format(count))
    count = num // 5000
    num %= 5000
    print("5000원 지폐: {}장".format(count))
    count = num // 1000
    num %= 1000
    print("1000원 지폐: {}장".format(count))

