# 원화(￦)에서 달러($)로 변환하는 함수
def krw_to_usd(krw):
    i = 0
    while i < len(krw):
        krw[i] = krw[i] / 1000
        i += 1
    return krw

# 달러($)에서 엔화(￥)로 변환하는 함수
def usd_to_jpy(usd):
    i = 0
    while i < len(usd):
        usd[i] = usd[i] * 125
        i += 1
    return usd

