# 구별선 -----------------------------------------------------------
AP_MONEY = 1100000000  # 아파트 가격
MONEY = 50000000       # 은행 예치금
YEAR = 1988
now_year = 2016

def bank(principal):
    diff_year = now_year - YEAR
    total_money = principal  # 초기 금액
    while diff_year > 0: # 원
        total_money *= 1.12  # 매년 12% 복리
        diff_year -= 1
    return total_money

final_money = bank(MONEY)

if final_money > AP_MONEY:
    print("{:.0f}원 차이로 동일 아저씨 말씀이 맞습니다.".format(final_money - AP_MONEY))
elif final_money < AP_MONEY:
    print("{:.0f}원 차이로 미란 아주머니 말씀이 맞습니다.".format(AP_MONEY - final_money))
else:
    print("두 분 말씀 모두 맞습니다!")


